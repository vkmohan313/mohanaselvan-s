   ],
   "source": [
    "import google.generativeai as genai\n",
    "genai.configure(api_key=\"AIzaSyCv6gIZQ4LvoR5ZGFV7EfUgVzhIo8N5U7U\")\n",
    "model = genai.GenerativeModel(\"gemini-2.0-flash\")\n",
    "def chat():\n",
    "    print(\"Dhiva Chatbot Activated \")\n",
    "    while True:\n",
    "        user_input = input(\"You: \")\n",
    "        if user_input.lower() == \"exit\":\n",
    "            print(\"Dhiva Kelumbu \")\n",
    "            break\n",
    "        response = model.generate_content(user_input)\n",
    "        print(\"Dhiva:\", response.text)\n",
    "chat()\n"
   ]
  },
